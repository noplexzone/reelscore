# Required: TMDB v3 API key or v4 read token.
TMDB_API_KEY=

# Runtime mode. Keep self_hosted until the hosted security checklist passes.
APP_MODE=self_hosted

# Generate with: openssl rand -hex 32
SESSION_SECRET=

# Hosted public origin, including https:// and no path (for example https://reels.example.com).
PUBLIC_URL=

# Public hosted v2 defaults to open registration and requires email delivery.
# Values: open, invite, closed, plex_server.
REGISTRATION_MODE=

# Required when hosted registration is open. `capture` is test-only; production
# uses `resend` after the production email worker is configured.
EMAIL_PROVIDER=
RESEND_API_KEY=
EMAIL_FROM=

# Explicit immediate-peer CIDRs Express may trust. Never use a hop count. The
# hosted Compose topology pins cloudflared to 172.29.0.2.
TRUSTED_PROXY_CIDRS=

# Fresh hosted database only: generate with `openssl rand -hex 32`, bootstrap
# the first admin once, then remove this variable and restart.
BOOTSTRAP_ADMIN_TOKEN=

# Added by the provider-auth slice. Hosted mode will require a 32-byte encryption key.
# Generate with: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=
CREDENTIAL_ENCRYPTION_KEY_ID=active
# JSON map of retired key IDs to old keys during rotation, for example {"key-2025":"..."}
CREDENTIAL_ENCRYPTION_PREVIOUS_KEYS={}

# Separate key for encrypted verification/reset payloads in the durable outbox.
# Rotating SESSION_SECRET does not affect queued mail. Keep retired key IDs until
# no queued/retryable jobs use them.
EMAIL_OUTBOX_ENCRYPTION_KEY=
EMAIL_OUTBOX_ENCRYPTION_KEY_ID=active
EMAIL_OUTBOX_ENCRYPTION_PREVIOUS_KEYS={}

PLEX_CLIENT_IDENTIFIER=
PLEX_ALLOWED_SERVER_ID=
# Required in hosted mode. Every credential-bearing Plex destination must match
# one of these independently configured exact origins, including public origins.
# Example: https://plex.example.com:32400,http://192.168.1.10:32400
PLEX_ALLOWED_ORIGINS=
# Optional local Plex account ID for legacy/manual links. Secure owner PIN links
# automatically scope history to account 1; ambiguous shared-user history fails closed.
PLEX_HISTORY_ACCOUNT_ID=

# Optional UTC date (YYYY-MM-DD) for admin placeholder previews. Defaults to today.
ONBOARDING_PLACEHOLDER_DATE=

# Trakt provider linking/login.
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=

# Hosted Compose only. Must not be the private/live ReelScore data directory.
HOSTED_DATA_DIR=
# Absolute path to a mode-0600 file containing only the hosted tunnel token.
CLOUDFLARE_TUNNEL_TOKEN_FILE=
