# Get a free API key at https://www.themoviedb.org/settings/api
# Either a v3 API key or a v4 read access token works.
TMDB_API_KEY=

# Any long random string. Generate one with: openssl rand -hex 32
JWT_SECRET=

# Optional: enable Trakt account linking (watch-history import + verified
# badges). Create an app at https://trakt.tv/oauth/applications — any redirect
# URI works, the device-code flow is used.
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=
