# Required: TMDB v3 API key or v4 read token.
TMDB_API_KEY=

# Runtime mode. Keep self_hosted until the hosted security checklist passes.
APP_MODE=self_hosted

# Generate with: openssl rand -hex 32
SESSION_SECRET=

# Hosted public origin, including https:// and no path (for example https://reels.example.com).
PUBLIC_URL=

# self_hosted defaults to open; hosted defaults to invite. Values: open, invite, closed.
REGISTRATION_MODE=

# Number of reverse-proxy hops Express may trust. Keep 0 unless the app is reachable only
# through that exact number of controlled proxy hops. Cloudflare Tunnel is normally 1 when
# cloudflared connects directly to this container and the container port is not public.
TRUST_PROXY=0

# Added by the provider-auth slice. Hosted mode will require a 32-byte encryption key.
# Generate with: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=
CREDENTIAL_ENCRYPTION_KEY_ID=active
# JSON map of retired key IDs to old keys during rotation, for example {"key-2025":"..."}
CREDENTIAL_ENCRYPTION_PREVIOUS_KEYS={}
PLEX_CLIENT_IDENTIFIER=
PLEX_ALLOWED_SERVER_ID=
# Comma-separated exact origins permitted when Plex advertises a private/LAN connection.
# Example: http://192.168.1.10:32400
PLEX_ALLOWED_ORIGINS=
# Optional local Plex account ID for legacy/manual links. Secure owner PIN links
# automatically scope history to account 1; ambiguous shared-user history fails closed.
PLEX_HISTORY_ACCOUNT_ID=

# Optional UTC date (YYYY-MM-DD) for admin placeholder previews. Defaults to today.
ONBOARDING_PLACEHOLDER_DATE=

# Trakt provider linking/login.
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=
